{
  "allowedDomains": [
    "www.cosme.net",
    "monipla.jp",
    "roomclip.jp",
    "lipscosme.com",
    "www.calbee.co.jp",
    "cocoromembers.jp.sharp",
    "cp-mk-1.makuake.com",
    "www.coca-cola.com",
    "pc.watch.impress.co.jp",
    "www.audio-technica.co.jp",
    "docs.google.com",
    "shop.tsukumo.co.jp",
    "www.e-earphone.jp"
  ],
  "manualOnly": [
    "lipscosme.com"
  ],
  "discovery": [
    {
      "source": "atcosme",
      "url": "https://www.cosme.net/present/",
      "enabled": true
    },
    {
      "source": "Monipla",
      "url": "https://monipla.jp/",
      "enabled": true
    },
    {
      "source": "RoomClip",
      "url": "https://roomclip.jp/monitor",
      "enabled": true
    },
    {
      "source": "PCWatch",
      "url": "https://pc.watch.impress.co.jp/docs/topic/present/",
      "enabled": true,
      "linkPattern": "^https://pc\\.watch\\.impress\\.co\\.jp/docs/topic/present/\\d+\\.html$",
      "titlePattern": "プレゼント",
      "requireDeadline": true,
      "genre": "ガジェット・家電"
    },
    {
      "source": "AudioTechnica",
      "url": "https://www.audio-technica.co.jp/news/",
      "enabled": true,
      "linkPattern": "^https://www\\.audio-technica\\.co\\.jp/news/detail/\\d+/?$",
      "titlePattern": "プレゼント|キャンペーン|当たる",
      "requireDeadline": true,
      "genre": "ガジェット・家電"
    },
    {
      "source": "Tsukumo",
      "url": "https://shop.tsukumo.co.jp/features/campaign/",
      "enabled": true,
      "linkPattern": "^https://shop\\.tsukumo\\.co\\.jp/features/[\\w-]+/?$",
      "requireDeadline": true,
      "bodyPattern": "抽選で|当たる|プレゼント",
      "titleExclude": "SALE|セール|実施中|まとめ",
      "maxDeadlineDays": 120,
      "genre": "ガジェット・家電"
    },
    {
      "source": "eEarphone",
      "url": "https://www.e-earphone.jp/blogs/campaign-sale",
      "enabled": true,
      "linkPattern": "^https://www\\.e-earphone\\.jp/blogs/campaign-sale/[\\w-]+$",
      "requireDeadline": true,
      "bodyPattern": "抽選で|当たる|プレゼント",
      "titleExclude": "SALE|セール|実施中|まとめ",
      "maxDeadlineDays": 120,
      "genre": "ガジェット・家電"
    }
  ],
  "note": "新規候補は6時間ごとに自動収集し、scripts/promote.mjs が締切・当選人数・条件を抽出して安全基準を満たすものを自動公開する。判定できない候補は data/review-queue.json に保留し自動で再判定する。LIPSは自動アクセスせず管理者確認を維持する。"
}
