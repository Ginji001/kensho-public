{
  "allowedDomains": [
    "www.cosme.net",
    "monipla.jp",
    "roomclip.jp",
    "lipscosme.com",
    "www.calbee.co.jp",
    "cocoromembers.jp.sharp",
    "cp-mk-1.makuake.com",
    "www.coca-cola.com",
    "pc.watch.impress.co.jp",
    "www.audio-technica.co.jp",
    "docs.google.com",
    "shop.tsukumo.co.jp",
    "www.e-earphone.jp",
    "www.4gamer.net",
    "news.mynavi.jp"
  ],
  "manualOnly": [
    "lipscosme.com"
  ],
  "discovery": [
    {
      "source": "atcosme",
      "url": "https://www.cosme.net/present/",
      "enabled": true,
      "bodyPattern": "プレゼント|抽選|当たる"
    },
    {
      "source": "Monipla",
      "url": "https://monipla.jp/",
      "enabled": true,
      "bodyPattern": "プレゼント|抽選|当たる|モニター"
    },
    {
      "source": "RoomClip",
      "url": "https://roomclip.jp/monitor",
      "enabled": true,
      "bodyPattern": "モニター|プレゼント|抽選",
      "titleExclude": "お知らせ|発売|受賞|特集",
      "applyUrlPattern": "^https://roomclip\\.jp/form/\\d+"
    },
    {
      "source": "PCWatch",
      "url": "https://pc.watch.impress.co.jp/",
      "enabled": false,
      "linkPattern": "^https://pc\\.watch\\.impress\\.co\\.jp/docs/topic/present/\\d+\\.html$",
      "titlePattern": "プレゼント",
      "requireDeadline": true,
      "genre": "ガジェット・家電",
      "disabledReason": "トップページから読者プレゼント記事のリンクを取得できず、一覧ページは自動アクセスを拒否するため停止（2026-09-25）"
    },
    {
      "source": "AudioTechnica",
      "url": "https://www.audio-technica.co.jp/news/",
      "enabled": false,
      "linkPattern": "^https://www\\.audio-technica\\.co\\.jp/news/detail/\\d+/?$",
      "titlePattern": "プレゼント|キャンペーン|当たる",
      "requireDeadline": true,
      "genre": "ガジェット・家電",
      "disabledReason": "ニュース一覧がJavaScript描画になりリンクを取得できないため停止（2026-09-15）"
    },
    {
      "source": "Tsukumo",
      "url": "https://shop.tsukumo.co.jp/features/campaign/",
      "enabled": true,
      "linkPattern": "^https://shop\\.tsukumo\\.co\\.jp/features/[\\w-]+/?$",
      "requireDeadline": true,
      "bodyPattern": "抽選で|当たる|プレゼント",
      "titleExclude": "SALE|セール|実施中|まとめ",
      "maxDeadlineDays": 120,
      "genre": "ガジェット・家電"
    },
    {
      "source": "eEarphone",
      "url": "https://www.e-earphone.jp/blogs/campaign-sale",
      "enabled": true,
      "linkPattern": "^https://www\\.e-earphone\\.jp/blogs/campaign-sale/[\\w-]+$",
      "requireDeadline": true,
      "bodyPattern": "抽選で|当たる|プレゼント",
      "titleExclude": "SALE|セール|実施中|まとめ",
      "maxDeadlineDays": 120,
      "genre": "ガジェット・家電"
    },
    {
      "source": "4Gamer",
      "url": "https://www.4gamer.net/tags/TN/TN024/",
      "enabled": true,
      "linkPattern": "^https://www\\.4gamer\\.net/games/\\d{3}/G\\d{6}/\\d{11}/$",
      "titlePattern": "^[［\\[]プレゼント[］\\]]",
      "requireDeadline": true,
      "maxDeadlineDays": 120,
      "urlDatePattern": "/(\\d{8})\\d{3}/?$",
      "maxArticleAgeDays": 60
    },
    {
      "source": "MynaviNews",
      "url": "https://news.mynavi.jp/present/",
      "enabled": true,
      "linkPattern": "^https://news\\.mynavi\\.jp/article/\\d{8}-present\\d+/$",
      "requireDeadline": true,
      "maxDeadlineDays": 120,
      "urlDatePattern": "/article/(\\d{8})-",
      "maxArticleAgeDays": 60,
      "applyUrlPattern": "^https://news\\.mynavi\\.jp/mypage/member/enquete/jump/"
    }
  ],
  "note": "新規候補は6時間ごとに自動収集し、scripts/promote.mjs が締切・当選人数・条件を抽出して安全基準を満たすものを自動公開する。判定できない候補は data/review-queue.json に保留し自動で再判定する。LIPSは自動アクセスせず管理者確認を維持する。"
}
